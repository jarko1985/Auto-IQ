# ── App ──────────────────────────────────────────────────────────────────────
APP_URL=http://localhost:3000
NODE_ENV=development
LOG_LEVEL=debug

# ── Database ─────────────────────────────────────────────────────────────────
# Docker Compose default: pnpm docker:up
DATABASE_URL=postgresql://user:password@localhost:5432/autoiq
# Used by Prisma migrations (bypasses connection pooling) — for a pooled
# provider (e.g. Neon), this is the same connection string without the pooler
# host/flag.
DIRECT_URL=postgresql://user:password@localhost:5432/autoiq

# ── Authentication (Auth.js v5) ───────────────────────────────────────────────
# Generate: openssl rand -base64 32
AUTH_SECRET=REPLACE_WITH_GENERATED_SECRET

# Google OAuth (Sprint 1) — see docs/guides/google-oauth-setup.md for how to obtain these.
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=

# Apple OAuth (Sprint 1)
# AUTH_APPLE_ID=
# AUTH_APPLE_SECRET=

# ── AI Providers (Sprint 4) ───────────────────────────────────────────────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AI_PRIMARY_PROVIDER=openai
AI_PRIMARY_MODEL=gpt-4o
AI_FALLBACK_PROVIDER=anthropic
AI_FALLBACK_MODEL=claude-sonnet-5

# ── Knowledge Base / RAG (Sprint 5) ───────────────────────────────────────────
AI_EMBEDDING_MODEL=text-embedding-3-small
AI_EMBEDDING_DIMENSIONS=1536

# ── Storage (Sprint 2) ────────────────────────────────────────────────────────
# STORAGE_PROVIDER=vercel-blob
# STORAGE_BUCKET=

# ── Payments (Stripe, test/sandbox mode — Sprint 13 / ADR-013) ───────────────
# See docs/guides/stripe-setup.md for how to obtain each of these.
PAYMENT_PROVIDER=stripe
# Stripe test-mode secret key (sk_test_...) — never a sk_live_... key here.
PAYMENT_SECRET_KEY=
# Signing secret from `stripe listen` (or a test-mode webhook endpoint), whsec_...
PAYMENT_WEBHOOK_SECRET=
# Publishable/public key for hosted client-side collection (pk_test_...) — not
# sensitive by design (the whole point of a "publishable" key), so this is the
# one payment var that is intentionally NEXT_PUBLIC_ — see Rule 8 and ADR-013.
NEXT_PUBLIC_PAYMENT_PUBLIC_KEY=

# ── Maps / Geocoding (Google, Sprint 21) ─────────────────────────────────────
# All optional — garage distance search / map pins degrade gracefully with no
# key configured (see CLAUDE.md's Sprint 21 notes).
MAPS_PROVIDER=google
# Server-side geocoding key (Geocoding API).
GOOGLE_MAPS_API_KEY=
# Client-side key for the interactive map (Maps JavaScript API) — a
# domain-restricted browser key is intentionally NEXT_PUBLIC_.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# ── Email (Gmail) ──────────────────────────────────────────────────────────────
# See docs/guides/gmail-setup.md for how to obtain a Gmail App Password.
# Defaults to "console" (logs instead of sending) when unset.
EMAIL_PROVIDER=gmail
# Your full Gmail address.
GMAIL_USER=
# 16-character App Password (not your regular Gmail password) — Google Account →
# Security → 2-Step Verification → App Passwords.
GMAIL_APP_PASSWORD=
# Optional — defaults to GMAIL_USER if unset.
EMAIL_FROM=

# ── SMS (Sprint 5) ────────────────────────────────────────────────────────────
# SMS_PROVIDER=
