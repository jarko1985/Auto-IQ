// REQUESTED -> ACCEPTED -> COMPLETED | NO_SHOW
// REQUESTED -> REJECTED | CANCELLED
// REQUESTED -> RESCHEDULE_PROPOSED -> ACCEPTED (customer accepts new time) | CANCELLED (declines)
// ACCEPTED -> CANCELLED (either party, before the visit)
enum BookingStatus {
  REQUESTED
  ACCEPTED
  RESCHEDULE_PROPOSED
  REJECTED
  CANCELLED
  COMPLETED
  NO_SHOW
}

// CREATED -> INSPECTION -> DIAGNOSIS -> ESTIMATE_DRAFT -> AWAITING_APPROVAL
//   -> APPROVED -> IN_REPAIR -> QUALITY_CHECK -> COMPLETED -> INVOICED
// AWAITING_APPROVAL -> REJECTED -> ESTIMATE_DRAFT (garage revises and resends)
// QUALITY_CHECK -> IN_REPAIR (rework)
// CANCELLED reachable from any pre-repair state (CREATED..APPROVED, REJECTED) — not once
// work is underway (IN_REPAIR onward) — see features/repair-orders/service.ts's
// ALLOWED_TRANSITIONS for the exact graph.
enum RepairOrderStatus {
  CREATED
  INSPECTION
  DIAGNOSIS
  ESTIMATE_DRAFT
  AWAITING_APPROVAL
  APPROVED
  REJECTED
  IN_REPAIR
  QUALITY_CHECK
  COMPLETED
  INVOICED
  CANCELLED
}

enum RepairJobStatus {
  PENDING
  IN_PROGRESS
  DONE
}

// ── Payments ──────────────────────────────────────────────────────────────────
// See docs/adr/ADR-013-payment-architecture.md for the full design (state
// machines, PCI boundary, reconciliation plan). Sprint 12 is schema + interface
// only — no provider is wired and no service layer mutates these tables yet.

// What an Invoice (and transitively a PaymentIntent) is paying for. Deliberately
// a plain type+id pair rather than two nullable FKs on Invoice, since VendorOrder
// and RepairOrder must not be modified this sprint — see ADR-013. New payable
// kinds (subscriptions, featured listings — Phase 5 of auto_iq.md) are additive.
enum PayableType {
  VENDOR_ORDER
  REPAIR_ORDER
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  PARTIALLY_REFUNDED
  REFUNDED
  VOID
}

// CREATED -> REQUIRES_ACTION -> PROCESSING -> SUCCEEDED
// CREATED -> PROCESSING -> SUCCEEDED (no extra customer action required)
// CREATED/REQUIRES_ACTION/PROCESSING -> FAILED
// FAILED -> CREATED (retry with a different payment method, same intent) or CANCELED
// CREATED/REQUIRES_ACTION -> CANCELED | EXPIRED
// SUCCEEDED is terminal — refunds are modeled on Refund/PaymentTransaction, never
// by reopening the intent. See features/payments/state-machines.ts for the
// code-level adjacency map (PAYMENT_INTENT_TRANSITIONS).
enum PaymentIntentStatus {
  CREATED
  REQUIRES_ACTION
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELED
  EXPIRED
}

enum PaymentTransactionType {
  AUTHORIZATION
  CAPTURE
  SALE
}

// PENDING -> SUCCEEDED | FAILED. Deliberately minimal: gateways normally report
// transactions already resolved (a webhook saying "charge succeeded/failed"),
// so PENDING is only the gap between our provider call and webhook confirmation.
// See features/payments/state-machines.ts (PAYMENT_TRANSACTION_TRANSITIONS).
enum PaymentTransactionStatus {
  PENDING
  SUCCEEDED
  FAILED
}

// REQUESTED -> PROCESSING -> SUCCEEDED | FAILED
// REQUESTED -> CANCELED (withdrawn before the provider call is made)
// FAILED/SUCCEEDED/CANCELED are terminal — a retry creates a new Refund row.
// See features/payments/state-machines.ts (REFUND_TRANSITIONS).
enum RefundStatus {
  REQUESTED
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELED
}

// Earned on a successful PaymentTransaction (PENDING) -> batched into a Payout
// (INCLUDED_IN_PAYOUT) -> paid out (PAID). REVERSED if the underlying
// transaction is refunded before it's batched — once INCLUDED_IN_PAYOUT a
// reversal is netted against a future payout instead (see ADR-013 limitations).
enum CommissionStatus {
  PENDING
  INCLUDED_IN_PAYOUT
  PAID
  REVERSED
}

// PENDING -> PROCESSING -> PAID | FAILED
// PENDING -> CANCELED (before processing starts, e.g. a commission dispute)
// FAILED -> PROCESSING (retry) | CANCELED
// PAID -> REVERSED (rare clawback, e.g. a chargeback discovered after payout)
// See features/payments/state-machines.ts (PAYOUT_TRANSITIONS).
enum PayoutStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
  CANCELED
  REVERSED
}

enum IdempotencyKeyStatus {
  IN_PROGRESS
  COMPLETED
  FAILED
}

// RECEIVED -> VERIFIED -> PROCESSED | IGNORED | FAILED. VERIFIED means the
// provider signature checked out; PROCESSED means it was applied to our
// ledger. IGNORED covers event types we intentionally don't act on.
enum WebhookEventStatus {
  RECEIVED
  VERIFIED
  PROCESSED
  IGNORED
  FAILED
}

// ── Identity ──────────────────────────────────────────────────────────────────

model User {
  id            String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name          String?
  email         String     @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  phone         String?    @unique
  phoneVerified DateTime?
  status        UserStatus @default(PENDING_VERIFICATION)
  // Platform-level identity role (CUSTOMER, or platform staff — ADMIN, SUPER_ADMIN,
  // SUPPORT_AGENT, CONTENT_MANAGER). Org-scoped roles (VENDOR_OWNER, GARAGE_MANAGER,
  // MECHANIC, ...) come from OrganizationMembership -> MembershipRole instead — see
  // resolveSessionRole() in features/auth/service.ts.
  role          RoleName   @default(CUSTOMER)
  // Interface language preference, set from the Settings page. Independent of
  // next-intl's URL-segment locale (which drives a given *request*'s rendering) —
  // this is what background triggers with no request context (e.g. notification
  // dispatch) read instead. See resolveLocale() in features/notifications/service.ts.
  locale        String     @default("en")
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  accounts                      Account[]
  sessions                      Session[]
  memberships                   OrganizationMembership[]
  auditLogs                     AuditLog[]
  passwordResets                PasswordResetToken[]
  customerVehicles              CustomerVehicle[]
  vehicleDocuments              VehicleDocument[]
  serviceHistory                ServiceHistoryEntry[]
  diagnosticSessions            DiagnosticSession[]
  uploadedKnowledgeDocuments    KnowledgeDocument[]        @relation("KnowledgeDocumentUploadedBy")
  approvedKnowledgeDocuments    KnowledgeDocument[]        @relation("KnowledgeDocumentApprovedBy")
  reviewedVendors               Vendor[]                   @relation("VendorReviewedBy")
  uploadedVendorDocuments       VendorDocument[]           @relation("VendorDocumentUploadedBy")
  reviewedGarages               Garage[]                   @relation("GarageReviewedBy")
  uploadedGarageDocuments       GarageDocument[]           @relation("GarageDocumentUploadedBy")
  sentStaffInvitations          StaffInvitation[]          @relation("StaffInvitationInvitedBy")
  approvedParts                 Part[]
  performedInventoryAdjustments InventoryAdjustment[]
  createdReservations           InventoryReservation[]
  vendorOrders                  VendorOrder[]
  vendorOrderStatusChanges      VendorOrderStatusHistory[]
  bookings                      Appointment[]              @relation("BookingCustomer")
  bookingCancellations          Appointment[]              @relation("BookingCancelledBy")
  bookingStatusChanges          AppointmentStatusHistory[]
  repairOrders                  RepairOrder[]              @relation("RepairOrderCustomer")
  repairOrderQcSignOffs         RepairOrder[]              @relation("RepairOrderQcSignedOffBy")
  repairOrderCancellations      RepairOrder[]              @relation("RepairOrderCancelledBy")
  repairOrderStatusChanges      RepairOrderStatusHistory[]
  qualityChecksPerformed        QualityCheckItem[]
  invoicesAsCustomer            Invoice[]
  refundsRequested              Refund[]
  notifications                 Notification[]
  notificationPreferences       NotificationPreference[]
  garageReviews                 GarageReview[]
  diagnosticShareLinksCreated   DiagnosticShareLink[]

  @@index([email])
  @@map("users")
}

// Auth.js v5 adapter models — field names must match exactly
model Account {
  id                String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String  @db.Uuid
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionToken String   @unique
  userId       String   @db.Uuid
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
  @@map("verification_tokens")
}

// ── Organizations ─────────────────────────────────────────────────────────────

model Organization {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  slug      String    @unique
  type      OrgType
  status    OrgStatus @default(PENDING_APPROVAL)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  memberships         OrganizationMembership[]
  vendor              Vendor?
  locations           VendorLocation[]
  garage              Garage?
  garageLocations     GarageLocation[]
  invitations         StaffInvitation[]
  invoicesAsRecipient Invoice[]
  commissions         Commission[]
  payouts             Payout[]

  @@index([slug])
  @@map("organizations")
}

model OrganizationMembership {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String   @db.Uuid
  organizationId String   @db.Uuid
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization     Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  roles            MembershipRole[]
  mechanicProfile  MechanicProfile?
  leadRepairOrders RepairOrder[]    @relation("RepairOrderLeadMechanic")
  assignedJobs     RepairJob[]      @relation("RepairJobMechanic")

  @@unique([userId, organizationId])
  @@map("organization_memberships")
}

// ── RBAC ─────────────────────────────────────────────────────────────────────

model Role {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        RoleName @unique
  description String?
  createdAt   DateTime @default(now())

  permissions RolePermission[]
  memberships MembershipRole[]

  @@map("roles")
}

model Permission {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  action    String   @unique
  resource  String
  createdAt DateTime @default(now())

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @db.Uuid
  permissionId String @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model MembershipRole {
  membershipId String @db.Uuid
  roleId       String @db.Uuid

  membership OrganizationMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  role       Role                   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([membershipId, roleId])
  @@map("membership_roles")
}

// ── Addresses ─────────────────────────────────────────────────────────────────

model Address {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  line1     String
  line2     String?
  city      String
  emirate   String
  country   String   @default("AE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("addresses")
}

// ── Vendor Onboarding ─────────────────────────────────────────────────────────

// Vendor-specific business profile — 1:1 with an Organization of type VENDOR.
// Organization carries platform-wide access state (status); Vendor carries the
// onboarding-specific verification workflow (DRAFT -> SUBMITTED -> APPROVED/REJECTED).
// The two are kept in sync in features/vendors/service.ts: approving/rejecting a
// Vendor also updates its Organization.status in the same transaction.
model Vendor {
  id             String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String @unique @db.Uuid

  businessName       String
  businessType       VendorBusinessType
  tradeLicenseNumber String             @unique
  tradeLicenseExpiry DateTime           @db.Date
  contactPersonName  String
  contactPhone       String
  contactEmail       String
  addressLine1       String
  emirate            Emirate

  // Authorized-signatory KYC fields — collected alongside document uploads
  authorizedSignatoryName       String?
  authorizedSignatoryEmiratesId String?

  verificationStatus VendorVerificationStatus @default(DRAFT)
  submittedAt        DateTime?
  reviewedAt         DateTime?
  reviewedById       String?                  @db.Uuid
  rejectionReason    String?                  @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  reviewedBy     User?            @relation("VendorReviewedBy", fields: [reviewedById], references: [id])
  documents      VendorDocument[]
  submittedParts Part[]
  inventoryItems InventoryItem[]
  vendorOrders   VendorOrder[]

  @@index([verificationStatus])
  @@map("vendors")
}

model VendorDocument {
  id           String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  vendorId     String             @db.Uuid
  type         VendorDocumentType
  storageKey   String
  filename     String
  mimeType     String
  sizeBytes    Int
  uploadedById String             @db.Uuid
  createdAt    DateTime           @default(now())

  vendor     Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  uploadedBy User   @relation("VendorDocumentUploadedBy", fields: [uploadedById], references: [id])

  @@index([vendorId])
  @@map("vendor_documents")
}

model VendorLocation {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @db.Uuid
  name           String
  emirate        Emirate
  addressLine1   String
  phone          String?
  email          String?
  isPrimary      Boolean  @default(false)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  inventoryItems InventoryItem[]
  vendorOrders   VendorOrder[]

  @@index([organizationId])
  @@map("vendor_locations")
}

// Generic org-staff invitation — scoped to a RoleName so it can be reused by the
// garage domain (Sprint 9) without a separate model.
model StaffInvitation {
  id             String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String                @db.Uuid
  email          String
  role           RoleName
  status         StaffInvitationStatus @default(PENDING)
  token          String                @unique
  invitedById    String                @db.Uuid
  expiresAt      DateTime
  acceptedAt     DateTime?
  createdAt      DateTime              @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy    User         @relation("StaffInvitationInvitedBy", fields: [invitedById], references: [id])

  @@index([organizationId])
  @@index([email])
  @@map("staff_invitations")
}

// Public, token-based read-only share link for a completed diagnostic result
// (Sprint 21.1 — Share Results). Mirrors StaffInvitation's token/expiresAt
// shape — the closest existing precedent for an unauthenticated-accessible
// token in this codebase. "One active link at a time" semantics: a session
// creating a new link while a non-revoked, non-expired one already exists
// just returns the existing one (see features/diagnostics/service.ts's
// getOrCreateShareLink) rather than spawning duplicates.
model DiagnosticShareLink {
