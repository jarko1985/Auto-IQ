// ── Automotive Knowledge Base (RAG) ────────────────────────────────────────────

// Approved-document store for retrieval-augmented diagnostic prompts.
// Indexing (chunk + embed) is a separate admin-triggered step from upload —
// see ADR-007 — so extracted text can be reviewed before spending on embeddings.
model KnowledgeDocument {
  id           String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title        String
  description  String?               @db.Text
  sourceName   String
  sourceUrl    String?
  documentType KnowledgeDocumentType

  // Vehicle applicability — null means "applies to all" for that dimension
  makeName   String?
  modelName  String?
  yearFrom   Int?
  yearTo     Int?
  engineCode String?

  storageKey    String
  filename      String
  mimeType      String
  sizeBytes     Int
  contentHash   String
  extractedText String? @db.Text

  approvalState   KnowledgeApprovalState   @default(PENDING_REVIEW)
  ingestionStatus KnowledgeIngestionStatus @default(PENDING)
  ingestionError  String?                  @db.Text

  version           Int     @default(1)
  previousVersionId String? @unique @db.Uuid

  uploadedById   String    @db.Uuid
  approvedById   String?   @db.Uuid
  approvedAt     DateTime?
  rejectedReason String?   @db.Text

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  uploadedBy      User               @relation("KnowledgeDocumentUploadedBy", fields: [uploadedById], references: [id])
  approvedBy      User?              @relation("KnowledgeDocumentApprovedBy", fields: [approvedById], references: [id])
  previousVersion KnowledgeDocument? @relation("KnowledgeDocumentVersion", fields: [previousVersionId], references: [id])
  nextVersion     KnowledgeDocument? @relation("KnowledgeDocumentVersion")
  chunks          KnowledgeChunk[]

  @@index([approvalState])
  @@index([documentType])
  @@index([contentHash])
  @@index([makeName, modelName])
  @@index([deletedAt])
  @@map("knowledge_documents")
}

model KnowledgeChunk {
  id         String                       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  documentId String                       @db.Uuid
  chunkIndex Int
  content    String                       @db.Text
  tokenCount Int
  // Populated via raw SQL only — Prisma Client has no native pgvector type.
  embedding  Unsupported("vector(1536)")?
  createdAt  DateTime                     @default(now())

  document KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, chunkIndex])
  @@index([documentId])
  @@map("knowledge_chunks")
}

// ── Parts Catalog ─────────────────────────────────────────────────────────────

model PartCategory {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code      String   @unique
  name      String
  nameAr    String?
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parts Part[]

  @@map("part_categories")
}

// Canonical, admin-approved part record. Vendors may propose a new Part (via
// features/catalog's submitPartProposal) but it stays PENDING_REVIEW — and cannot
// be attached to an InventoryItem — until an admin approves it. This is the
// review gate that prevents vendors from creating conflicting canonical data
// (Prompt 13), rather than blocking vendor-originated parts outright.
model Part {
  id                   String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  categoryId           String            @db.Uuid
  manufacturerName     String
  partNumber           String
  alternatePartNumbers String[]
  name                 String
  description          String?           @db.Text
  origin               PartOrigin
  approvalState        PartApprovalState @default(PENDING_REVIEW)
  submittedByVendorId  String?           @db.Uuid
  approvedById         String?           @db.Uuid
  approvedAt           DateTime?
  rejectionReason      String?           @db.Text
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  deletedAt            DateTime?

  category          PartCategory        @relation(fields: [categoryId], references: [id])
  submittedByVendor Vendor?             @relation(fields: [submittedByVendorId], references: [id])
  approvedBy        User?               @relation(fields: [approvedById], references: [id])
  media             PartMedia[]
  compatibilities   PartCompatibility[]
  inventoryItems    InventoryItem[]

  @@unique([manufacturerName, partNumber])
  @@index([categoryId])
  @@index([approvalState])
  @@index([deletedAt])
  @@map("parts")
}

model PartMedia {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  partId     String   @db.Uuid
  storageKey String
  filename   String
  mimeType   String
  sizeBytes  Int
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())

  part Part @relation(fields: [partId], references: [id], onDelete: Cascade)

  @@index([partId])
  @@map("part_media")
}

// Vehicle applicability for a Part — makeName/modelName are required (unlike
// KnowledgeDocument's fully-nullable applicability) since a compatibility rule
// only exists to scope a part to specific vehicles. yearFrom/yearTo/engineCode/
// trimName null means "applies to all" for that dimension — same convention as
// features/knowledge/filters.ts.
model PartCompatibility {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  partId     String   @db.Uuid
  makeName   String
  modelName  String
  yearFrom   Int?
  yearTo     Int?
  engineCode String?
  trimName   String?
  notes      String?  @db.Text
  createdAt  DateTime @default(now())

  part Part @relation(fields: [partId], references: [id], onDelete: Cascade)

  @@index([partId])
  @@index([makeName, modelName])
  @@map("part_compatibilities")
}

// ── Inventory & Vendor Orders ─────────────────────────────────────────────────

// Location-scoped vendor stock for one Part. qtyAvailable is sellable stock;
// qtyReserved is stock held against PENDING_CONFIRMATION..PREPARING VendorOrders
// (see features/inventory/service.ts reserveStock/releaseStock); qtyDamaged is a
// separate quarantine bucket adjusted manually. `version` guards optimistic
// updates to price/threshold; the qty fields are additionally guarded by a
// conditional UPDATE ... WHERE qtyAvailable >= :amount at the SQL level to
// prevent overselling under concurrent reservations.
model InventoryItem {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  partId           String   @db.Uuid
  vendorId         String   @db.Uuid
  locationId       String   @db.Uuid
  priceMinorUnits  Int
  currency         String   @default("AED")
  qtyAvailable     Int      @default(0)
  qtyReserved      Int      @default(0)
  qtyDamaged       Int      @default(0)
  reorderThreshold Int      @default(0)
  isActive         Boolean  @default(true)
  version          Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  part         Part                   @relation(fields: [partId], references: [id])
  vendor       Vendor                 @relation(fields: [vendorId], references: [id])
  location     VendorLocation         @relation(fields: [locationId], references: [id])
  adjustments  InventoryAdjustment[]
  reservations InventoryReservation[]
  orderItems   VendorOrderItem[]

  @@unique([vendorId, locationId, partId])
  @@index([vendorId])
  @@index([partId])
  @@index([locationId])
  @@map("inventory_items")
}

// Append-only audit trail for every stock mutation — this is the "Inventory
// Audit Log" (Prompt 14). qty*Delta is the signed change applied in that
// mutation; qty*After is the resulting balance, so a row is self-contained for
// display without joining back through history.
model InventoryAdjustment {
  id                String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  inventoryItemId   String              @db.Uuid
  changeType        InventoryChangeType
  qtyAvailableDelta Int
  qtyReservedDelta  Int                 @default(0)
  qtyDamagedDelta   Int                 @default(0)
  qtyAvailableAfter Int
  qtyReservedAfter  Int
  qtyDamagedAfter   Int
  reason            String?             @db.Text
  performedById     String?             @db.Uuid
  createdAt         DateTime            @default(now())

  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  performedBy   User?         @relation(fields: [performedById], references: [id])

  @@index([inventoryItemId])
  @@index([createdAt])
  @@map("inventory_adjustments")
}

// A temporary hold on stock created when a VendorOrder is placed (1:1 with a
// VendorOrderItem once consumed). expiresAt enables lazy expiry — checked when
// an order is read/confirmed rather than via a scheduled job, since no job
// queue exists yet (ADR pending for Sprint 12+).
model InventoryReservation {
  id              String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  inventoryItemId String            @db.Uuid
  quantity        Int
  status          ReservationStatus @default(ACTIVE)
  expiresAt       DateTime
  createdById     String            @db.Uuid
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  inventoryItem   InventoryItem    @relation(fields: [inventoryItemId], references: [id])
  createdBy       User             @relation(fields: [createdById], references: [id])
  vendorOrderItem VendorOrderItem?

  @@index([inventoryItemId])
  @@index([status, expiresAt])
  @@map("inventory_reservations")
}

// A customer order placed directly against vendor inventory. No Cart/checkout
// step yet (Commerce domain is Sprint 12) — placing the order both reserves
// stock and creates this record in one transaction; totals are always computed
// server-side from InventoryItem.priceMinorUnits, never trusted from the client.
model VendorOrder {
  id                   String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderNumber          String            @unique
  customerId           String            @db.Uuid
  vendorId             String            @db.Uuid
  locationId           String            @db.Uuid
  status               VendorOrderStatus @default(PENDING_CONFIRMATION)
  subtotalMinorUnits   Int
  vatMinorUnits        Int
  totalMinorUnits      Int
  currency             String            @default("AED")
  deliveryAddressLine1 String?
  deliveryEmirate      Emirate?
  contactPhone         String?
  confirmedAt          DateTime?
  preparedAt           DateTime?
  readyAt              DateTime?
  completedAt          DateTime?
  cancelledAt          DateTime?
  cancelledReason      String?           @db.Text
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  customer      User                       @relation(fields: [customerId], references: [id])
  vendor        Vendor                     @relation(fields: [vendorId], references: [id])
  location      VendorLocation             @relation(fields: [locationId], references: [id])
  items         VendorOrderItem[]
  statusHistory VendorOrderStatusHistory[]

  @@index([customerId])
  @@index([vendorId])
  @@index([status])
  @@index([createdAt])
  @@map("vendor_orders")
}

model VendorOrderItem {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  vendorOrderId       String   @db.Uuid
  inventoryItemId     String   @db.Uuid
  partId              String   @db.Uuid
  partNameSnapshot    String
  quantity            Int
  unitPriceMinorUnits Int
  totalMinorUnits     Int
  reservationId       String?  @unique @db.Uuid
  createdAt           DateTime @default(now())

  vendorOrder   VendorOrder           @relation(fields: [vendorOrderId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem         @relation(fields: [inventoryItemId], references: [id])
  reservation   InventoryReservation? @relation(fields: [reservationId], references: [id])

  @@index([vendorOrderId])
  @@map("vendor_order_items")
}

model VendorOrderStatusHistory {
  id            String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  vendorOrderId String             @db.Uuid
  fromStatus    VendorOrderStatus?
  toStatus      VendorOrderStatus
  changedById   String?            @db.Uuid
  note          String?            @db.Text
  createdAt     DateTime           @default(now())

  vendorOrder VendorOrder @relation(fields: [vendorOrderId], references: [id], onDelete: Cascade)
  changedBy   User?       @relation(fields: [changedById], references: [id])

  @@index([vendorOrderId])
  @@map("vendor_order_status_history")
}

// ── Garage Onboarding and Operations ───────────────────────────────────────────

// Garage-specific business profile — 1:1 with an Organization of type GARAGE.
// Mirrors Vendor's split exactly: Organization carries platform-wide access
// state (status); Garage carries the onboarding-specific verification workflow
// (DRAFT -> SUBMITTED -> APPROVED/REJECTED), kept in sync in
// features/garages/service.ts the same way features/vendors/service.ts does.
model Garage {
  id             String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String @unique @db.Uuid

  businessName       String
  tradeLicenseNumber String   @unique
  tradeLicenseExpiry DateTime @db.Date
  contactPersonName  String
  contactPhone       String
  contactEmail       String
  addressLine1       String
  emirate            Emirate

  // Authorized-signatory KYC fields — collected alongside document uploads
  authorizedSignatoryName       String?
  authorizedSignatoryEmiratesId String?

  verificationStatus GarageVerificationStatus @default(DRAFT)
  submittedAt        DateTime?
  reviewedAt         DateTime?
  reviewedById       String?                  @db.Uuid
  rejectionReason    String?                  @db.Text

  // Sprint 21 — cached rating, recomputed transactionally on every
  // GarageReview insert (features/garages/repository.ts's createReview) rather
  // than computed live in search, since search is a hot paginated read path —
  // same write-time-aggregation precedent as RepairOrder's pre-computed totals.
  reviewCount   Int   @default(0)
  averageRating Float @default(0)

  // Public-facing profile media/copy — nullable, seed-populated for the demo
  // garages only for now; no garage-owner self-service edit UI exists yet for
  // either field (same class of gap as e.g. the storage provider's TODO).
  photoUrl    String?
  description String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization        Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  reviewedBy          User?                      @relation("GarageReviewedBy", fields: [reviewedById], references: [id])
  documents           GarageDocument[]
  services            GarageService[]
  vehicleCapabilities GarageVehicleCapability[]
  makeSpecializations GarageMakeSpecialization[]
  appointments        Appointment[]
  repairOrders        RepairOrder[]
  reviews             GarageReview[]

  @@index([verificationStatus])
  @@map("garages")
}

model GarageDocument {
  id           String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  garageId     String             @db.Uuid
  type         GarageDocumentType
  storageKey   String
  filename     String
  mimeType     String
  sizeBytes    Int
  uploadedById String             @db.Uuid
  createdAt    DateTime           @default(now())

  garage     Garage @relation(fields: [garageId], references: [id], onDelete: Cascade)
  uploadedBy User   @relation("GarageDocumentUploadedBy", fields: [uploadedById], references: [id])

  @@index([garageId])
  @@map("garage_documents")
}

model GarageLocation {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @db.Uuid
  name           String
  emirate        Emirate
  addressLine1   String
  phone          String?
  email          String?
  isPrimary      Boolean  @default(false)
  isActive       Boolean  @default(true)
  // Sprint 21 — distance search / map pins. Nullable: a location with no
  // coordinates still works everywhere, it just can't be distance-sorted or
  // pinned. Plain Float (not Decimal) — no real precision need at UAE scale,
  // matching the existing non-money-numeric convention (e.g. DiagnosticQuestion
  // min/maxValue).
  latitude       Float?
  longitude      Float?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workingHours GarageWorkingHours[]
  appointments Appointment[]
  repairOrders RepairOrder[]

  @@index([organizationId])
  @@map("garage_locations")
}

// One row per day of the week for a location. dayOfWeek 0 = Sunday .. 6 =
// Saturday (UAE work week convention). isClosed short-circuits open/closeTime.
model GarageWorkingHours {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  locationId String   @db.Uuid
  dayOfWeek  Int
  isClosed   Boolean  @default(false)
  openTime   String? // "HH:mm", 24-hour
  closeTime  String? // "HH:mm", 24-hour
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  location GarageLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([locationId, dayOfWeek])
  @@index([locationId])
  @@map("garage_working_hours")
}

// A service the garage offers, drawn from the same ServiceType enum customers
// use to log ServiceHistoryEntry rows — keeps the vocabulary of "what a garage
// can do" and "what work was done" aligned.
model GarageService {
  id          String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  garageId    String      @db.Uuid
  serviceType ServiceType
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  garage Garage @relation(fields: [garageId], references: [id], onDelete: Cascade)

  @@unique([garageId, serviceType])
  @@index([garageId])
  @@map("garage_services")
}

// Which vehicle categories (sedan, SUV, heavy truck, ...) a garage is
// equipped to service — reuses the same VehicleType enum as CustomerVehicle.
model GarageVehicleCapability {
  id          String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  garageId    String      @db.Uuid
  vehicleType VehicleType
  createdAt   DateTime    @default(now())

  garage Garage @relation(fields: [garageId], references: [id], onDelete: Cascade)

  @@unique([garageId, vehicleType])
  @@index([garageId])
  @@map("garage_vehicle_capabilities")
}

// Vehicle makes a garage specializes in — free-text brand specialization
// scoped to the real VehicleMake catalog rather than a denormalized string,
// consistent with PartCompatibility's use of the catalog elsewhere.
model GarageMakeSpecialization {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  garageId  String   @db.Uuid
  makeId    String   @db.Uuid
  createdAt DateTime @default(now())

  garage Garage      @relation(fields: [garageId], references: [id], onDelete: Cascade)
  make   VehicleMake @relation(fields: [makeId], references: [id])

  @@unique([garageId, makeId])
  @@index([garageId])
  @@map("garage_make_specializations")
}

// Extended profile for a MECHANIC-role membership — skills/experience beyond
// what OrganizationMembership + MembershipRole already capture. 1:1 with the
// membership so it is automatically scoped to the correct garage and user.
model MechanicProfile {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  membershipId    String        @unique @db.Uuid
  specialties     ServiceType[]
  yearsExperience Int?
  bio             String?       @db.Text
  isActive        Boolean       @default(true)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  membership OrganizationMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@map("mechanic_profiles")
}

// A customer's rating of a garage — gated on a verified-completed repair
// order rather than a moderation queue (Sprint 21). repairOrderId (not
// (customerId, garageId)) is the natural 1:1 key, matching
// DiagnosticFeedback.sessionId — one review per completed repair, no
// updatedAt (create-only, same shape as DiagnosticFeedback).
model GarageReview {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  garageId      String   @db.Uuid
  customerId    String   @db.Uuid
  repairOrderId String   @unique @db.Uuid
  rating        Int
  comment       String?  @db.Text
  createdAt     DateTime @default(now())

  garage      Garage      @relation(fields: [garageId], references: [id], onDelete: Cascade)
  customer    User        @relation(fields: [customerId], references: [id])
  repairOrder RepairOrder @relation(fields: [repairOrderId], references: [id], onDelete: Cascade)

  @@index([garageId])
  @@map("garage_reviews")
}

// ── Bookings ──────────────────────────────────────────────────────────────────

// A customer's appointment request against one garage location, optionally
// carrying a completed DiagnosticSession's context through to the garage.
// Slots are deterministic (fixed-duration grid aligned to GarageWorkingHours,
// see features/bookings/slots.ts) so an overlap can only ever occur between
// appointments sharing the exact same scheduledStart at a location. Preventing
// double-booking therefore doesn't need inventory's guarded-UPDATE trick (this
// is an INSERT, which has no equivalent atomic WHERE guard) — instead
// createBooking() takes a Postgres transaction-scoped advisory lock keyed on
// locationId before checking for an existing active booking in that slot, so
// two concurrent requests for the same slot cannot both pass the check (see
// features/bookings/repository.ts).
model Appointment {
  id            String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookingNumber String @unique

  customerId          String  @db.Uuid
  vehicleId           String  @db.Uuid
  garageId            String  @db.Uuid
  locationId          String  @db.Uuid
  diagnosticSessionId String? @db.Uuid

  serviceType ServiceType

  status         BookingStatus @default(REQUESTED)
  scheduledStart DateTime
  scheduledEnd   DateTime

  // Set while status = RESCHEDULE_PROPOSED — the garage's proposed alternate
  // slot, held separately so the originally requested slot isn't lost while
  // awaiting the customer's decision. Copied onto scheduled* and cleared when
  // the customer accepts.
  proposedStart  DateTime?
  proposedEnd    DateTime?
  rescheduleNote String?   @db.Text

  customerNotes   String? @db.Text
  rejectionReason String? @db.Text
  cancelledReason String? @db.Text
  cancelledById   String? @db.Uuid

  acceptedAt  DateTime?
  completedAt DateTime?
  noShowAt    DateTime?
  cancelledAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customer          User                       @relation("BookingCustomer", fields: [customerId], references: [id])
  vehicle           CustomerVehicle            @relation(fields: [vehicleId], references: [id])
  garage            Garage                     @relation(fields: [garageId], references: [id])
  location          GarageLocation             @relation(fields: [locationId], references: [id])
  diagnosticSession DiagnosticSession?         @relation(fields: [diagnosticSessionId], references: [id])
  cancelledBy       User?                      @relation("BookingCancelledBy", fields: [cancelledById], references: [id])
  statusHistory     AppointmentStatusHistory[]
  repairOrder       RepairOrder?

  @@index([customerId])
  @@index([garageId])
  @@index([locationId, scheduledStart])
  @@index([status])
  @@map("appointments")
}

model AppointmentStatusHistory {
  id            String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  appointmentId String         @db.Uuid
  fromStatus    BookingStatus?
  toStatus      BookingStatus
  changedById   String?        @db.Uuid
  note          String?        @db.Text
  createdAt     DateTime       @default(now())

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  changedBy   User?       @relation(fields: [changedById], references: [id])

  @@index([appointmentId])
  @@map("appointment_status_history")
}

// ── Repair Orders ─────────────────────────────────────────────────────────────

// A garage's workshop record for one vehicle visit, created from an ACCEPTED
// Appointment (1:1 via appointmentId) when the customer checks in. Carries the
// full inspection -> diagnosis -> estimate -> approval -> repair -> QC ->
// completion -> invoice lifecycle (RepairOrderStatus). Line items (RepairJob,
// RepairOrderPart) are only editable during the estimate-building phase
// (DIAGNOSIS/ESTIMATE_DRAFT/REJECTED) — see features/repair-orders/service.ts —
// so totals snapshotted at sendEstimate() and finalizeInvoice() are always
// server-computed and never re-derived from client input.
model RepairOrder {
  id                String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  repairOrderNumber String @unique

  customerId          String  @db.Uuid
  vehicleId           String  @db.Uuid
  garageId            String  @db.Uuid
  locationId          String  @db.Uuid
  appointmentId       String  @unique @db.Uuid
  diagnosticSessionId String? @db.Uuid

  status      RepairOrderStatus @default(CREATED)
  serviceType ServiceType

  // Initial inspection
  inspectionNotes     String?   @db.Text
  odometerReadingKm   Int?
  inspectionStartedAt DateTime?

  // Diagnosis — aiSuggestedDiagnosis/aiConfidence are a snapshot of the linked
  // DiagnosticSession's top-ranked DiagnosticCause at creation time, if any.
  aiSuggestedDiagnosis String?
  aiConfidence         Int?
  confirmedDiagnosis   String?
  diagnosisRecordedAt  DateTime?

  // Estimate — server-computed from jobs + parts at sendEstimate() time
  laborSubtotalMinorUnits Int       @default(0)
  partsSubtotalMinorUnits Int       @default(0)
  vatMinorUnits           Int       @default(0)
  totalMinorUnits         Int       @default(0)
  currency                String    @default("AED")
  customerNotes           String?   @db.Text
  estimateSentAt          DateTime?
  rejectionReason         String?   @db.Text

  leadMechanicMembershipId String? @db.Uuid

  qcSignedOffById String?   @db.Uuid
  qcSignedOffAt   DateTime?

  completedAt               DateTime?
  invoicedAt                DateTime?
  warrantyDurationMonths    Int?
  warrantyCoverageItems     String[]
  warrantyTerms             String?   @db.Text
  outcomeNotes              String?   @db.Text
  customerVerifiedOutcomeAt DateTime?

  cancelledAt     DateTime?
  cancelledReason String?   @db.Text
  cancelledById   String?   @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customer          User                    @relation("RepairOrderCustomer", fields: [customerId], references: [id])
  vehicle           CustomerVehicle         @relation(fields: [vehicleId], references: [id])
  garage            Garage                  @relation(fields: [garageId], references: [id])
  location          GarageLocation          @relation(fields: [locationId], references: [id])
  appointment       Appointment             @relation(fields: [appointmentId], references: [id])
  diagnosticSession DiagnosticSession?      @relation(fields: [diagnosticSessionId], references: [id])
  leadMechanic      OrganizationMembership? @relation("RepairOrderLeadMechanic", fields: [leadMechanicMembershipId], references: [id])
  qcSignedOffBy     User?                   @relation("RepairOrderQcSignedOffBy", fields: [qcSignedOffById], references: [id])
  cancelledBy       User?                   @relation("RepairOrderCancelledBy", fields: [cancelledById], references: [id])

  jobs          RepairJob[]
  parts         RepairOrderPart[]
  qualityChecks QualityCheckItem[]
  statusHistory RepairOrderStatusHistory[]
  review        GarageReview?

  @@index([customerId])
  @@index([garageId])
  @@index([status])
  @@index([createdAt])
  @@map("repair_orders")
}

// A unit of work on a RepairOrder — combines "job" (description) and "labor"
// (mechanic/hours/rate) into one row, matching the Stitch "Jobs & Labor" table
// which shows exactly these fields together. status tracks execution progress
// once the RO is IN_REPAIR; description/mechanic/hours/rate are only editable
// during the estimate-building phase (see features/repair-orders/service.ts).
model RepairJob {
  id                   String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  repairOrderId        String          @db.Uuid
  description          String
  mechanicMembershipId String?         @db.Uuid
  hours                Float
  rateMinorUnits       Int
  totalMinorUnits      Int
  status               RepairJobStatus @default(PENDING)
  sortOrder            Int             @default(0)
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  repairOrder RepairOrder             @relation(fields: [repairOrderId], references: [id], onDelete: Cascade)
  mechanic    OrganizationMembership? @relation("RepairJobMechanic", fields: [mechanicMembershipId], references: [id])

  @@index([repairOrderId])
  @@map("repair_jobs")
}

// A part consumed on a RepairOrder. Free-text (partName/sku) rather than a
// catalog Part reference — garages don't have a Part/InventoryItem catalog of
// their own (that's the vendor domain, Sprint 8) and linking RO parts to
// vendor inventory/fulfillment is out of scope for this sprint.
model RepairOrderPart {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  repairOrderId       String   @db.Uuid
  partName            String
  sku                 String?
  quantity            Int
  unitPriceMinorUnits Int
  totalMinorUnits     Int
  sortOrder           Int      @default(0)
  createdAt           DateTime @default(now())

  repairOrder RepairOrder @relation(fields: [repairOrderId], references: [id], onDelete: Cascade)

  @@index([repairOrderId])
  @@map("repair_order_parts")
}

// A single checklist line in the pre-completion quality check. Garage-defined
// (no fixed universal checklist) — added while IN_REPAIR/QUALITY_CHECK, all
// must be checked before signOffQualityCheck() can transition to COMPLETED.
model QualityCheckItem {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  repairOrderId String    @db.Uuid
  label         String
  isChecked     Boolean   @default(false)
  checkedById   String?   @db.Uuid
  checkedAt     DateTime?
  sortOrder     Int       @default(0)
  createdAt     DateTime  @default(now())

  repairOrder RepairOrder @relation(fields: [repairOrderId], references: [id], onDelete: Cascade)
  checkedBy   User?       @relation(fields: [checkedById], references: [id])

  @@index([repairOrderId])
  @@map("repair_order_quality_checks")
}

model RepairOrderStatusHistory {
  id            String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  repairOrderId String             @db.Uuid
  fromStatus    RepairOrderStatus?
  toStatus      RepairOrderStatus
  changedById   String?            @db.Uuid
  note          String?            @db.Text
  createdAt     DateTime           @default(now())

  repairOrder RepairOrder @relation(fields: [repairOrderId], references: [id], onDelete: Cascade)
  changedBy   User?       @relation(fields: [changedById], references: [id])

  @@index([repairOrderId])
  @@map("repair_order_status_history")
}

// ── Payments ──────────────────────────────────────────────────────────────────
// Sprint 12 (design only — see docs/adr/ADR-013-payment-architecture.md). No
// service layer writes to these tables yet; Prompt 19 implements the provider
// adapter and the code that creates/mutates these rows.

// The financial record of what a customer owes for a VendorOrder or a
// RepairOrder, independent of either domain's own workflow status. Linked by
// payableType+payableId rather than a Prisma relation so that VendorOrder and
// RepairOrder — out of scope this sprint — are not touched at all; there is no
// DB-level FK, so referential integrity for the payable side is the
// responsibility of whatever creates the Invoice (documented in ADR-013).
// lineItemsSnapshot freezes a copy of the source domain's line items at issue
// time so the invoice (and any PDF rendered from it) never silently changes if
// the underlying RepairJob/RepairOrderPart/VendorOrderItem rows are edited later.
model Invoice {
  id            String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  invoiceNumber String      @unique
  payableType   PayableType
  payableId     String      @db.Uuid

  customerId              String @db.Uuid
  recipientOrganizationId String @db.Uuid

  status             InvoiceStatus @default(DRAFT)
  subtotalMinorUnits Int
  vatMinorUnits      Int
  totalMinorUnits    Int
  currency           String        @default("AED")
  lineItemsSnapshot  Json

  issuedAt  DateTime?
  dueAt     DateTime?
  paidAt    DateTime?
  voidedAt  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  customer  User         @relation(fields: [customerId], references: [id])
  recipient Organization @relation(fields: [recipientOrganizationId], references: [id])

  paymentIntents PaymentIntent[]

  @@index([payableType, payableId])
  @@index([customerId])
  @@index([recipientOrganizationId])
  @@index([status])
  @@map("invoices")
}

// One checkout session/attempt for an Invoice. provider/providerIntentId are
// free-text (not an enum) — see lib/payments/types.ts's PaymentProviderName —
// matching the existing aiProvider: String? pattern on DiagnosticResult, so
// adding a gateway never requires a migration. clientSecret is an opaque token
// handed to the client for hosted/provider-secure collection; card data itself
// must never reach a field on this or any AutoIQ model (PCI boundary, ADR-013).
model PaymentIntent {
  id               String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  invoiceId        String              @db.Uuid
  provider         String
  providerIntentId String?
  status           PaymentIntentStatus @default(CREATED)
  amountMinorUnits Int
  currency         String              @default("AED")
  clientSecret     String?
  failureReason    String?
  idempotencyKeyId String?             @unique @db.Uuid
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  invoice        Invoice         @relation(fields: [invoiceId], references: [id])
  idempotencyKey IdempotencyKey? @relation(fields: [idempotencyKeyId], references: [id])

  transactions  PaymentTransaction[]
  webhookEvents WebhookEvent[]

  @@index([invoiceId])
  @@index([status])
  @@index([provider, providerIntentId])
  @@map("payment_intents")
}

// The append-only ledger of gateway-reported money-movement attempts for a
// PaymentIntent (authorize/capture/sale). Refunds are NOT PaymentTransaction
// rows — they're their own Refund model, referencing the transaction refunded.
model PaymentTransaction {
  id                    String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  paymentIntentId       String                   @db.Uuid
  type                  PaymentTransactionType
  status                PaymentTransactionStatus @default(PENDING)
  amountMinorUnits      Int
  currency              String                   @default("AED")
  providerTransactionId String?
  failureCode           String?
  failureMessage        String?
  rawResponseSnapshot   Json?
  occurredAt            DateTime                 @default(now())
  createdAt             DateTime                 @default(now())

  paymentIntent PaymentIntent @relation(fields: [paymentIntentId], references: [id])

  refunds    Refund[]
  commission Commission?

  @@index([paymentIntentId])
  @@index([providerTransactionId])
  @@map("payment_transactions")
}

// A refund against a specific successful (CAPTURE/SALE) PaymentTransaction.
// requestedById is null for system-initiated refunds (e.g. an auto-refund on
// order cancellation) as opposed to an admin/support action.
model Refund {
  id               String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  transactionId    String       @db.Uuid
  requestedById    String?      @db.Uuid
  status           RefundStatus @default(REQUESTED)
  amountMinorUnits Int
  currency         String       @default("AED")
  reason           String?      @db.Text
  providerRefundId String?
  failureReason    String?
  processedAt      DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  transaction PaymentTransaction @relation(fields: [transactionId], references: [id])
  requestedBy User?              @relation(fields: [requestedById], references: [id])

  @@index([transactionId])
  @@index([status])
  @@map("refunds")
}

// The platform's cut of one successful PaymentTransaction, and what's left
// owed to the vendor/garage (recipientOrganizationId — Vendor and Garage are
// both 1:1 with an Organization, so this reuses that existing anchor instead
// of a union of vendorId/garageId). rateBasisPoints follows the existing
// VAT_RATE_BPS convention (features/repair-orders/service.ts, features/vendor-orders).
model Commission {
  id                         String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  transactionId              String           @unique @db.Uuid
  recipientOrganizationId    String           @db.Uuid
  status                     CommissionStatus @default(PENDING)
  grossAmountMinorUnits      Int
  rateBasisPoints            Int
  commissionAmountMinorUnits Int
  payoutAmountMinorUnits     Int
  currency                   String           @default("AED")
  payoutId                   String?          @db.Uuid
  createdAt                  DateTime         @default(now())

  transaction PaymentTransaction @relation(fields: [transactionId], references: [id])
  recipient   Organization       @relation(fields: [recipientOrganizationId], references: [id])
  payout      Payout?            @relation(fields: [payoutId], references: [id])

  @@index([recipientOrganizationId])
  @@index([status])
  @@index([payoutId])
  @@map("commissions")
}

// A batch payment of accumulated Commission.payoutAmountMinorUnits to one
// vendor/garage Organization over [periodStart, periodEnd]. provider here is
// the payout rail (may differ from the PaymentProvider that collected the
// original charge — e.g. a direct bank transfer batch) — also free-text.
model Payout {
  id                      String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  payoutNumber            String       @unique
  recipientOrganizationId String       @db.Uuid
  status                  PayoutStatus @default(PENDING)
  amountMinorUnits        Int
  currency                String       @default("AED")
  periodStart             DateTime
  periodEnd               DateTime
  provider                String?
  providerPayoutId        String?
  failureReason           String?
  processedAt             DateTime?
  createdAt               DateTime     @default(now())
  updatedAt               DateTime     @updatedAt

  recipient   Organization @relation(fields: [recipientOrganizationId], references: [id])
  commissions Commission[]

  @@index([recipientOrganizationId])
  @@index([status])
  @@map("payouts")
}

// Generic idempotency guard for client-initiated mutating payment requests
// (e.g. POST /payment-intents retried by a flaky client must not create two
// intents). scope+key is the uniqueness boundary, not key alone, so the same
// raw key can't collide across unrelated endpoints. A replay with the same
// scope+key but a different requestHash is a client error, not a safe replay
// (see ADR-013's reconciliation plan) — expiresAt enables the same lazy-expiry
// convention used for stale VendorOrder reservations (Sprint 8) since no job
// queue exists yet.
model IdempotencyKey {
  id               String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key              String
  scope            String
  requestHash      String
  status           IdempotencyKeyStatus @default(IN_PROGRESS)
  responseSnapshot Json?
  resourceType     String?
  resourceId       String?              @db.Uuid
  createdAt        DateTime             @default(now())
  expiresAt        DateTime

  paymentIntent PaymentIntent?

  @@unique([scope, key])
  @@index([expiresAt])
  @@map("idempotency_keys")
}

// Inbound webhook log — generic (not payments-only, per ADR-011's original
// intent) even though payments are the only producer so far. The
// (provider, providerEventId) unique constraint is the core dedupe mechanism:
// a provider's retry of the same event hits a P2002 on insert, handled the
// same way Sprint 6's DiagnosticResult handles a P2002 race — treat it as
// "already processed" and return success, never double-apply the event.
model WebhookEvent {
  id                String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  provider          String
  providerEventId   String
  eventType         String
  payloadRaw        Json
  signatureVerified Boolean            @default(false)
  status            WebhookEventStatus @default(RECEIVED)
  paymentIntentId   String?            @db.Uuid
  attempts          Int                @default(0)
  lastError         String?            @db.Text
  receivedAt        DateTime           @default(now())
  processedAt       DateTime?

  paymentIntent PaymentIntent? @relation(fields: [paymentIntentId], references: [id])

  @@unique([provider, providerEventId])
  @@index([status])
  @@index([paymentIntentId])
  @@map("webhook_events")
}

// ── Notifications (Sprint 14 / Prompt 20) ──────────────────────────────────────

enum NotificationEventType {
  EMAIL_VERIFICATION
  DIAGNOSTIC_COMPLETE
  BOOKING_REQUESTED
  BOOKING_ACCEPTED
  ESTIMATE_READY
  ESTIMATE_APPROVED
  PAYMENT_COMPLETE
  PAYMENT_FAILED
  REPAIR_STATUS_CHANGED
  REPAIR_COMPLETED
}

enum NotificationCategory {
  ACCOUNT
  DIAGNOSTICS
  BOOKINGS
  REPAIR_ORDERS
  PAYMENTS
}

enum NotificationChannel {
  EMAIL
  SMS
  IN_APP
}

enum NotificationDeliveryStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

// One logical notification instance per recipient per event occurrence. The
// in-app "delivery" IS this row existing — readAt tracks the in-app read
// state directly here rather than in a NotificationDelivery row, since
// there's nothing else for an IN_APP channel to record. dedupKey scopes the
// natural idempotency key of the triggering event (sessionId, bookingId,
// repairOrderId+status, invoiceId, ...) — a retried dispatch for the same
// (userId, eventType, dedupKey) hits P2002 and is treated as already-sent,
// the same pattern Sprint 6/13 use for DiagnosticResult/WebhookEvent races.
model Notification {
  id        String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String                @db.Uuid
  eventType NotificationEventType
  category  NotificationCategory
  title     String
  body      String                @db.Text
  data      Json?
  dedupKey  String
  readAt    DateTime?
  createdAt DateTime              @default(now())

  user       User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveries NotificationDelivery[]

  @@unique([userId, eventType, dedupKey])
  @@index([userId, readAt])
  @@index([userId, category])
  @@map("notifications")
}

// Per-channel delivery attempt/outcome for a Notification (EMAIL/SMS only —
// IN_APP is tracked on Notification itself, see above). attempts/lastError
// record the in-process retry loop features/notifications/service.ts runs
// synchronously (no job scheduler exists yet, matching the lazy/synchronous
// convention every other domain in this codebase uses for the same gap).
model NotificationDelivery {
  id             String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  notificationId String                     @db.Uuid
  channel        NotificationChannel
  status         NotificationDeliveryStatus @default(PENDING)
  attempts       Int                        @default(0)
  lastError      String?                    @db.Text
  sentAt         DateTime?
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@unique([notificationId, channel])
  @@map("notification_deliveries")
}

// Per-user, per-event channel opt-in/out. No row means "use the event's
// documented default" (features/notifications/defaults.ts) — rows are only
// written when a user actually changes something, not pre-seeded for every
// user/event pair. EMAIL_VERIFICATION is intentionally never editable here
// (enforced server-side in features/notifications/service.ts, not just
// hidden in the UI) — a user cannot opt out of the one email that unlocks
// their account.
model NotificationPreference {
  id           String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String                @db.Uuid
  eventType    NotificationEventType
  emailEnabled Boolean               @default(true)
  smsEnabled   Boolean               @default(false)
  inAppEnabled Boolean               @default(true)
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, eventType])
  @@map("notification_preferences")
}
