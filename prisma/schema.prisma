/// Sprint 20 — question text is now either AI_GENERATED (a session-scoped
/// batch produced by generateSessionQuestions(), tailored to that session's
/// vehicle/category/description) or STATIC (the small, category-agnostic
/// emergency fallback bank shown only when generation fails/times out).
/// The old per-category seeded bank this replaced always had categoryId set
/// and no sessionId — that source no longer exists.
enum QuestionSource {
  STATIC
  AI_GENERATED
}

model DiagnosticQuestion {
  id         String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  categoryId String?        @db.Uuid
  sessionId  String?        @db.Uuid
  source     QuestionSource @default(STATIC)
  code       String         @unique
  type       QuestionType
  text       String
  textAr     String?
  helpText   String?
  options    Json?
  unit       String?
  minValue   Float?
  maxValue   Float?
  isRequired Boolean        @default(true)
  sortOrder  Int            @default(0)
  isActive   Boolean        @default(true)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  category SymptomCategory?   @relation(fields: [categoryId], references: [id])
  session  DiagnosticSession? @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  answers  DiagnosticAnswer[]

  @@index([categoryId])
  @@index([sessionId])
  @@map("diagnostic_questions")
}

model DiagnosticAnswer {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId  String   @db.Uuid
  questionId String   @db.Uuid
  value      Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  session  DiagnosticSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  question DiagnosticQuestion @relation(fields: [questionId], references: [id])

  @@unique([sessionId, questionId])
  @@index([sessionId])
  @@map("diagnostic_answers")
}

model DiagnosticAttachment {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId  String   @db.Uuid
  storageKey String
  filename   String
  mimeType   String
  sizeBytes  Int
  createdAt  DateTime @default(now())

  session DiagnosticSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@map("diagnostic_attachments")
}

model DiagnosticFeedback {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId String   @unique @db.Uuid
  rating    Int
  comment   String?  @db.Text
  createdAt DateTime @default(now())

  session DiagnosticSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("diagnostic_feedback")
}

model DiagnosticResult {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId            String   @unique @db.Uuid
  severity             Severity
  safeToDrive          Boolean?
  emergencyAction      String?  @db.Text
  limitations          String[]
  costRangeMinMinor    Int?
  costRangeMaxMinor    Int?
  costRangeCurrency    String?
  isDegraded           Boolean  @default(false)
  degradedReason       String?  @db.Text
  aiProvider           String?
  aiModel              String?
  promptVersionId      String?  @db.Uuid
  knowledgeDocumentIds String[]
  // Sprint 15 — plain-language customer explanation / technical garage brief,
  // generated once alongside the main result (never regenerated on read).
  // Both null when isDegraded or when their AI call itself failed — never
  // guessed, and never allowed to contradict severity/safeToDrive above.
  customerExplanation  String?  @db.Text
  garageSummary        String?  @db.Text
  createdAt            DateTime @default(now())

  session       DiagnosticSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  promptVersion PromptVersion?    @relation(fields: [promptVersionId], references: [id])
  causes        DiagnosticCause[]

  @@map("diagnostic_results")
}

model DiagnosticCause {
  id                      String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  resultId                String   @db.Uuid
  rank                    Int
  issueCode               String
  label                   String
  confidence              Int
  evidence                String[]
  missingEvidence         String[]
  suggestedChecks         String[]
  requiredServiceCodes    String[]
  likelyPartCategoryCodes String[]
  createdAt               DateTime @default(now())

  result DiagnosticResult @relation(fields: [resultId], references: [id], onDelete: Cascade)

  @@index([resultId])
  @@map("diagnostic_causes")
}

